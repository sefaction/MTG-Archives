DATABASE_URL=postgresql://mtginventory:mtginventory@postgres:5432/mtginventory?schema=public
PRICING_DATABASE_URL=postgresql://mtgpricing:mtgpricing@pricing-postgres:5432/mtgpricing?schema=public
APP_DATABASE_URL=postgresql://mtginventory:mtginventory@postgres:5432/mtginventory?schema=public
REDIS_URL=redis://redis:6379
POSTGRES_DB=mtginventory
POSTGRES_USER=mtginventory
POSTGRES_PASSWORD=mtginventory
POSTGRES_HOST_PORT=15435
PRICING_POSTGRES_DB=mtgpricing
PRICING_POSTGRES_USER=mtgpricing
PRICING_POSTGRES_PASSWORD=mtgpricing
PRICING_POSTGRES_HOST_PORT=15436
WEB_HOST_PORT=13001
NEXT_PUBLIC_APP_NAME=MTG Inventory
SEED_ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
# Prebuilt image deployment. Branch tags are sanitized by GitHub Actions, for example
# IMAGE_TAG=platform-pricing-worker-stack for the platform/pricing-worker-stack branch.
IMAGE_TAG=main
# WEB_IMAGE=ghcr.io/sefaction/mtg-archives-web:main
# Persistent host storage. Use complete paths because Portainer/Unraid handling of nested variable expansion can vary.
APP_DATA_PATH=/mnt/user/appdata/mtg-archive
POSTGRES_DATA_PATH=/mnt/user/appdata/mtg-archive/postgres
PRICING_POSTGRES_DATA_PATH=/mnt/user/appdata/mtg-archive/pricing-postgres
REDIS_DATA_PATH=/mnt/user/appdata/mtg-archive/redis
UPLOADS_DATA_PATH=/mnt/user/appdata/mtg-archive/uploads
IMPORTS_DATA_PATH=/mnt/user/appdata/mtg-archive/imports
EXPORTS_DATA_PATH=/mnt/user/appdata/mtg-archive/exports
BACKUPS_DATA_PATH=/mnt/user/appdata/mtg-archive/backups
SCRYFALL_DATA_PATH=/mnt/user/appdata/mtg-archive/scryfall
BACKUP_DIR=/app/backups
# Optional comma-separated list. Defaults to uploads, imports, exports, and Scryfall container data when set.
# BACKUP_APPDATA_PATHS=/app/uploads,/app/imports
# Optional retention applied after successful backup creation.
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=20

# Scryfall API and local catalog behavior
SCRYFALL_API_BASE_URL=https://api.scryfall.com
SCRYFALL_USER_AGENT=MTG-Archives/1.0
SCRYFALL_MIN_REQUEST_INTERVAL_MS=100
SCRYFALL_MAX_RETRIES=4
SCRYFALL_REQUEST_TIMEOUT_MS=15000
SCRYFALL_CACHE_ENABLED=true
SCRYFALL_CARD_REFRESH_DAYS=30
SCRYFALL_PRICE_REFRESH_HOURS=24
SCRYFALL_BULK_DATA_ENABLED=true
SCRYFALL_CONTAINER_DATA_PATH=/app/data/scryfall
SCRYFALL_BULK_REFRESH_HOURS=24

# Import card-resolution jobs
IMPORT_RESOLVE_BATCH_SIZE=50
IMPORT_RESOLVE_MAX_BATCHES_PER_RUN=0
IMPORT_RESOLVE_POLL_INTERVAL_MS=1500
IMPORT_RESOLVE_STALE_JOB_TIMEOUT_MINUTES=15
# Optional for Portainer/Unraid Stack "Repository" workflows that build from git
GIT_CONTEXT=https://github.com/sefaction/MTG-Archives.git#main
DOCKERFILE_PATH=./Dockerfile
# Your server LAN IP for browser access
UNRAID_HOST_IP=192.168.1.2

# Set to true only if you serve the app over HTTPS
COOKIE_SECURE=false

# Recover from Prisma P3009 failed migration marker on startup
AUTO_RESOLVE_FAILED_MIGRATION=true
# DANGER: set true only if you want to wipe all DB data on startup
WIPE_DB_ON_START=false

# Keep startup stable by default: no demo/seed data unless explicitly enabled
RUN_SEED_ON_START=false

# MTGJSON pricing imports (daily worker-scheduled and manual/admin-triggered)
MTGJSON_BASE_URL=https://mtgjson.com/api/v5
MTGJSON_PRICE_PROVIDER_DEFAULT=tcgplayer
MTGJSON_PRICE_CURRENCY_DEFAULT=USD
MTGJSON_PRICE_IMPORT_ENABLED=true
PRICING_WORKER_INTERVAL_MS=15000
PRICING_AUTO_SCHEDULE_ENABLED=true
PRICING_DAILY_REFRESH_ENABLED=true
PRICING_DAILY_IDENTIFIER_MAPPING_ENABLED=true
PRICING_IMPORT_BATCH_SIZE=500
# Optional development safety cap. 0 imports all cards from AllPricesToday.
PRICING_IMPORT_MAX_CARDS=0
# Optional override for testing a fixture or mirror.
# MTGJSON_ALL_PRICES_URL=https://mtgjson.com/api/v5/AllPricesToday.json
# MTGJSON_ALL_IDENTIFIERS_URL=https://mtgjson.com/api/v5/AllIdentifiers.json
PRICE_WORKER_POLL_INTERVAL_MS=5000
PRICE_WORKER_HEARTBEAT_INTERVAL_MS=15000
RUN_PRICE_IMPORT_ON_START=false
