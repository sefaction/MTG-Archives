DATABASE_URL=postgresql://mtginventory:mtginventory@postgres:5432/mtginventory?schema=public
POSTGRES_DB=mtginventory
POSTGRES_USER=mtginventory
POSTGRES_PASSWORD=mtginventory
POSTGRES_HOST_PORT=15437
WEB_HOST_PORT=13003
NEXT_PUBLIC_APP_NAME=MTG Inventory
SEED_ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
POSTGRES_DATA_PATH=/mnt/user/appdata/mtg-archive/postgres
# Optional for Portainer/Unraid Stack "Repository" workflows that build from git
GIT_CONTEXT=https://github.com/sefaction/MTG-Archives.git#main
DOCKERFILE_PATH=./Dockerfile
# Your server LAN IP for browser access
UNRAID_HOST_IP=192.168.1.2

# Set to true only if you serve the app over HTTPS
COOKIE_SECURE=false

# Recover from Prisma P3009 failed migration marker on startup
AUTO_RESOLVE_FAILED_MIGRATION=true
# DANGER: set true only if you want to wipe all DB data on startup
WIPE_DB_ON_START=false

# Keep startup stable by default: no demo/seed data unless explicitly enabled
RUN_SEED_ON_START=false
