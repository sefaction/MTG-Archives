FROM mtg-acquisition-eval:local
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir paddlepaddle==3.2.0 paddleocr==3.2.0
ENV PADDLE_PDX_CACHE_HOME=/models PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
COPY paddle_baseline.py /eval/paddle_baseline.py
ENTRYPOINT ["python", "/eval/paddle_baseline.py"]
