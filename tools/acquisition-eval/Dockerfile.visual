FROM python:3.12-slim-bookworm
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# GPU is optional for one-time development indexing; deployed CPU support stays required.
RUN pip install --no-cache-dir torch==2.8.0 torchvision==0.23.0 --index-url ${TORCH_INDEX_URL}
RUN pip install --no-cache-dir numpy==2.2.6 opencv-python-headless==4.12.0.88 pillow==11.3.0
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 TORCH_HOME=/models
WORKDIR /eval
ENTRYPOINT ["python"]
