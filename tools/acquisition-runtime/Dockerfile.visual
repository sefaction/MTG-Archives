# CPU candidate retrieval; all weights/indexes remain in persistent mounts.
FROM node:22-bookworm-slim AS node-runtime
FROM python:3.12-slim-bookworm
RUN pip install --no-cache-dir torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir numpy==2.2.6 opencv-python-headless==4.12.0.88 pillow==11.3.0
ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 HOME=/tmp/mtg-acquisition-native
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
WORKDIR /app
COPY package.json package-lock.json ./
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js ci
COPY prisma ./prisma
RUN node node_modules/prisma/build/index.js generate
COPY lib ./lib
COPY scripts ./scripts
COPY tools/acquisition-runtime/visual.py tools/acquisition-runtime/printing.py tools/acquisition-runtime/printing_worker.py ./tools/acquisition-runtime/
COPY tools/acquisition-eval/baseline.py tools/acquisition-eval/catalog_index.py tools/acquisition-eval/catalog_references.py tools/acquisition-eval/catalog_snapshot.py tools/acquisition-eval/catalog_refresh.py tools/acquisition-eval/image_encoder.py tools/acquisition-eval/visual_compare.py tools/acquisition-eval/printing_evidence.py tools/acquisition-eval/stamp-reference-labels.json /eval/
ENTRYPOINT ["node", "node_modules/tsx/dist/cli.mjs", "scripts/acquisition-visual-worker.ts"]
