<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Mtg.ScannerAgent</AssemblyName>
    <Version>0.3.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" Version="1.3.0" />
    <PackageReference Include="NAPS2.Images.Gdi" Version="1.3.0" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="1.3.0" />
  </ItemGroup>
</Project>
