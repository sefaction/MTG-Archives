{
  "name": "mtg-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "webhook:key:ensure": "tsx scripts/ensure-webhook-encryption-key.ts",
    "backup:create": "tsx scripts/backup-create.ts",
    "backup:list": "tsx scripts/backup-list.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "worker:prices": "tsx scripts/pricing-worker.ts",
    "worker:prices:once": "tsx scripts/pricing-worker.ts --once",
    "worker:notifications": "tsx scripts/notification-worker.ts",
    "worker:notifications:once": "tsx scripts/notification-worker.ts --once",
    "ui:test": "playwright test",
    "ui:test:headed": "playwright test --headed",
    "ui:report": "playwright show-report",
    "verify": "npm.cmd run prisma:generate && npm.cmd run typecheck && npm.cmd test && npm.cmd run build && npm.cmd run ui:test",
    "typecheck": "tsc --noEmit",
    "format": "npx prettier --check .",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@tanstack/react-table": "^8.20.5",
    "bcryptjs": "^2.4.3",
    "keyrune": "^3.19.0",
    "mana-font": "^1.18.0",
    "next": "^15.3.2",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.15.21",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "postcss": "^8.5.3",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
